<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The system splash stays plain black: the animated logo is drawn by the app
      (ColdStartSplash in :sharedUi) on the same black, so the two read as one screen.
    -->
    <style name="Theme.Laya" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
