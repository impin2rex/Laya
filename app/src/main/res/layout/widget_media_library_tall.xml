<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 "Now playing + Liked" widget in a tall cell (MediaWidgetLibrary.TALL_MIN_DP
  and up — Samsung's 4×2 is about 190dp): the cover as tall as its row, the
  track over the transport beside it, and the liked covers along the bottom.

  The rows share the height 3:2, and both scale with it: the cover is square by
  adjustViewBounds, and each tile is a fitCenter square in its weighted cell.
  With no liked songs the bottom row is gone and the top one takes the whole
  widget, so a signed-out widget is a large now-playing card rather than one
  with a hole in it.

  Same ids as widget_media_library, so MediaWidgetLibrary.views binds either.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_library_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_library_background"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/widget_now_playing"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_artwork"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_library_tile_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="26dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!--
                  Pulled left by the previous button's own inset, so its glyph
                  lines up under the title rather than 8dp inside it.
                -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_previous"
                        android:layout_width="@dimen/widget_button_wide"
                        android:layout_height="@dimen/widget_button_wide"
                        android:background="@drawable/widget_transport_button"
                        android:contentDescription="@string/widget_previous"
                        android:padding="9dp"
                        android:src="@drawable/ic_widget_previous" />

                    <ImageView
                        android:id="@+id/widget_toggle"
                        android:layout_width="@dimen/widget_button_wide"
                        android:layout_height="@dimen/widget_button_wide"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/widget_transport_button"
                        android:contentDescription="@string/widget_play"
                        android:padding="6dp"
                        android:src="@drawable/ic_widget_play" />

                    <ImageView
                        android:id="@+id/widget_next"
                        android:layout_width="@dimen/widget_button_wide"
                        android:layout_height="@dimen/widget_button_wide"
                        android:background="@drawable/widget_transport_button"
                        android:contentDescription="@string/widget_next"
                        android:padding="9dp"
                        android:src="@drawable/ic_widget_next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_liked_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_liked_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_library_tile_placeholder" />

            <ImageView
                android:id="@+id/widget_liked_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_library_tile_placeholder" />

            <ImageView
                android:id="@+id/widget_liked_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_library_tile_placeholder" />

            <ImageView
                android:id="@+id/widget_liked_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_library_tile_placeholder" />

            <ImageView
                android:id="@+id/widget_liked_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_library_tile_placeholder" />
        </LinearLayout>
    </LinearLayout>

    <!-- The Laya mark, top right, as Spotify's widget carries its own. Opens the app. -->
    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="14dp"
        android:layout_marginRight="14dp"
        android:alpha="0.9"
        android:contentDescription="@string/widget_open_laya"
        android:src="@drawable/ic_notification_logo" />
</FrameLayout>
