[Unit]
Description=Laya Listen Together server
After=network-online.target
Wants=network-online.target

[Service]
User=laya
ExecStart=/opt/laya-jam/server
Restart=always
RestartSec=2

# A reverse proxy on this host terminates TLS on 443 and forwards
# X-Forwarded-For. The server binds 127.0.0.1 (JAM_BIND default), so :8000 is
# not reachable off the box at all.
Environment=PORT=8000
Environment=JAM_BIND=127.0.0.1
Environment=JAM_TRUST_PROXY=true
Environment=JAM_MAX_MEMBERS=5
Environment=JAM_STATE_HEARTBEAT_MS=5000
Environment=JAM_MAX_UPCOMING_QUEUE=25
Environment=JAM_MAX_PARTIES=200
Environment=JAM_CREATE_RATE_PER_MINUTE=2
Environment=JAM_CONNECTION_IDLE_MS=900000

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
