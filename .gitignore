# Gradle
.gradle/
.vscode/
/build/
/app/build/
/desktopApp/bin/
build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Local configuration file (SDK path, etc.)
local.properties

# Kotlin
.kotlin/

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Log/OS files
*.log
.DS_Store
Thumbs.db

# Release signing — never commit the key or its passwords
keystore.properties
*.jks
*.keystore

# Project scratch / debug artifacts
.shots/
.tmp_verify/
.debug/

# AI agent configuration
AGENTS.md
/output/

# Built packages — release APKs/bundles are handed out, never committed
*.apk
*.aab

# Local agent task logs (iOS port decisions, etc.)
.claude/tasks/
.claude/worktrees/

# iOS (XcodeGen output)
iosApp/*.xcodeproj
# Vendor holds local pod archives and other build inputs, except the vendored
# onnxruntime package, which has to be in the repo for the build to resolve at
# all: upstream deleted it (iosApp/Vendor/README.md).
iosApp/Vendor/*
!iosApp/Vendor/README.md
!iosApp/Vendor/onnxruntime-swift-package-manager/

# graphify (local knowledge graph, rebuild with `graphify update .`)
graphify-out/
